---
interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Kolade Oyewumi - Software Engineer',
  description = `Kolade Oyewumi is a software engineer based in Nigeria, building clean, smooth, interactive interfaces for platforms, products, and teams shipping real software.`,
} = Astro.props;
const siteUrl = 'https://kolade.tech';
const imageUrl = `${siteUrl}/logo512.png`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#11100e" />
    <meta name="description" content={description} />
    <meta name="author" content="Kolade Oyewumi" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={siteUrl} />
    <link rel="preload" href="/fonts/Satoshi-Regular.otf" as="font" type="font/otf" crossorigin />
    <link rel="preload" href="/fonts/Satoshi-Medium.otf" as="font" type="font/otf" crossorigin />
    <link rel="preload" href="/fonts/Satoshi-Bold.otf" as="font" type="font/otf" crossorigin />
    <title>{title}</title>
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:site_name" content="Kolade Oyewumi" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="google-site-verification" content="v2mdVS0_S5uOnPwD5KuLMqHZkyJ_bngFp2sp87VMRjc" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: 'Kolade Oyewumi',
      url: siteUrl,
      jobTitle: 'Software Engineer',
      email: 'mailto:oyewumi.koladej@gmail.com',
      sameAs: [
        'https://www.linkedin.com/in/kolade-oyewumi-644492195/',
        'https://github.com/corlard3y',
      ],
      address: {
        '@type': 'PostalAddress',
        addressCountry: 'NG',
      },
      knowsAbout: [
        'Frontend Engineering',
        'React',
        'TypeScript',
        'Interactive Interfaces',
        'Product Engineering',
      ],
    })}></script>
    <!-- Set theme before paint to avoid flash -->
    <script is:inline>
      const savedTheme = localStorage.getItem('theme');
      const t = savedTheme === 'light' || savedTheme === 'dark' ? savedTheme : 'dark';
      if (!savedTheme) localStorage.setItem('theme', 'dark');
      document.documentElement.setAttribute('data-theme', t);
    </script>

    <!-- Google tag (gtag.js) -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){window.dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-1HK7Y4THFG');

      window.addEventListener('load', () => {
        const gaScript = document.createElement('script');
        gaScript.async = true;
        gaScript.src = 'https://www.googletagmanager.com/gtag/js?id=G-1HK7Y4THFG';
        document.head.appendChild(gaScript);
      });
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
