---
import Layout from '../layouts/Layout.astro';
import { ScrambleDecode } from '../components/ScrambleDecode';
import { ThemeToggle } from '../components/ThemeToggle';
import {
  additionalProjects,
  capabilities,
  featuredProjects,
  skills,
  work,
} from '../data';
import '../styles/index.css';
import '../index.css';
---

<Layout>
  <div class="site-noise" aria-hidden="true"></div>
  <div class="ticker" aria-label="Current focus">
    <div class="ticker-track">
      <span>Available for work</span>
      <span>Available for work</span>
      <span>Available for work</span>
      <span>Available for work</span>
      <span>Available for work</span>
      <span>Available for work</span>
      <span>Available for work</span>
      <span>Available for work</span>
      <span>Available for work</span>
      <span>Available for work</span>
      <span>Available for work</span>
      <span>Available for work</span>
    </div>
  </div>

  <header class="header">
    <span class="header-name">
      Kolade<span class="cursor">_</span>
    </span>

    <nav class="header-nav">
      <a href="#projects">Projects</a>
      <a href="#experience">Experience</a>
      <a href="https://www.linkedin.com/in/kolade-oyewumi-644492195/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a href="https://github.com/corlard3y" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href="mailto:oyewumi.koladej@gmail.com">Email</a>
      <ThemeToggle client:load />
    </nav>
  </header>

  <main class="main">
    <section class="hero" aria-labelledby="intro-title">
      <p class="hero-kicker">Frontend engineer · Nigeria · shipping globally</p>
      <h1 id="intro-title" class="hero-title">
        I build interfaces for products that move messages, money, and users.
      </h1>
      <div class="hero-grid">
        <p class="hero-desc">
          7+ years building production React, Next.js and Web3 products across
          wallet-native communication, developer platforms, digital health,
          HR systems, logistics and commercial websites.
        </p>
        <div class="hero-proof" aria-label="Selected highlights">
          <span>7+ years experience</span>
          <span>10+ products shipped</span>
          <!-- <span>5+ live public apps</span> -->
          <!-- <span>4 product domains</span> -->
        </div>
      </div>
    </section>

    <section id="projects" class="section projects-section">
      <p class="section-label">Featured projects</p>

      <div class="project-grid">
        {featuredProjects.map((project, index) => (
          <article class="project-card">
            <div class="project-card-top">
              <span class="card-index">0{index + 1}</span>
              <span class="project-status">{project.status}</span>
            </div>
            <div class="project-card-main">
              <p class="project-category">{project.category}</p>
              <h2>{project.name}</h2>
              <p class="project-summary">{project.summary}</p>
            </div>
            <div class="project-detail-grid">
              <div>
                <span>Role</span>
                <p>{project.role}</p>
              </div>
              <div>
                <span>Period</span>
                <p>{project.period}</p>
              </div>
            </div>
            <div class="project-stack">
              {project.stack.map((item) => <span>{item}</span>)}
            </div>
            <div class="project-links">
              {project.links.map((link) => (
                <a href={link.url} target="_blank" rel="noopener noreferrer">
                  {link.label} ↗
                </a>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section additional-section">
      <p class="section-label">Additional selected work</p>

      <div class="additional-grid">
        {additionalProjects.map((project) => (
          <article class="additional-card">
            <p class="project-category">{project.category}</p>
            <h2>{project.name}</h2>
            <p class="project-summary">{project.summary}</p>
            <p class="work-role">{project.role}</p>
            <div class="project-stack compact-stack">
              {project.stack.map((item) => <span>{item}</span>)}
            </div>
            <div class="project-links">
              {project.links.map((link) => (
                <a href={link.url} target="_blank" rel="noopener noreferrer">
                  {link.label} ↗
                </a>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Capabilities section hidden for now; keep data/styles available for later review. -->

    <section id="experience" class="section">
      <p class="section-label">Experience</p>
      <div class="work-list">
        {work.map((w) => (
          <a
            href={w.url}
            target={w.url !== '#' ? '_blank' : undefined}
            rel="noopener noreferrer"
            class="work-card"
          >
            <div class="work-meta">
              <span>{w.eyebrow}</span>
              <span>{w.period}</span>
            </div>
            <div class="work-main">
              <div>
                <h2>{w.company}</h2>
                <p class="work-role">{w.role}</p>
              </div>
              {w.url !== '#' && <span class="work-arrow">↗</span>}
            </div>
            <span class="experience-link">View company ↗</span>
          </a>
        ))}
      </div>
    </section>

    <section class="section">
      <p class="section-label">About</p>
      <div class="about-grid">
        <p class="about-lede">
          I sit where product taste meets frontend systems: turning complex
          workflows into interfaces people can understand, trust, and use at
          speed.
        </p>
        <div>
          <p class="about-text">
            I’ve architected reward systems, design systems, and
            developer-facing tools across decentralized protocols, healthcare,
            and enterprise platforms.
          </p>
          <p class="about-text">
            I care about performance, accessibility, and shipping things that
            hold up once real users start leaning on them.
          </p>
        </div>
      </div>
      <div class="skills">
        {skills.map((s) => <span class="skill-tag">{s}</span>)}
      </div>
    </section>

    <ScrambleDecode client:visible />

    <section class="section">
      <p class="section-label">Connect</p>
      <div class="contact-panel">
        <p>
          Have a product interface, Web3 UX problem, or frontend system that
          needs sharper execution?
        </p>
        <a href="mailto:oyewumi.koladej@gmail.com" class="connect-email">
          oyewumi.koladej@gmail.com →
        </a>
      </div>
    </section>
  </main>

  <footer class="footer">
    <span class="footer-copy">© 2026 Kolade Oyewumi</span>
    <div class="footer-links">
      <a href="https://www.linkedin.com/in/kolade-oyewumi-644492195/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a href="https://github.com/corlard3y" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href="mailto:oyewumi.koladej@gmail.com">Email</a>
    </div>
  </footer>
</Layout>
