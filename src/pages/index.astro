---
import Layout from '../layouts/Layout.astro';
import { ScrambleDecode } from '../components/ScrambleDecode';
import { ThemeToggle } from '../components/ThemeToggle';
import {
  featuredProjects,
  skillGroups,
  work,
} from '../data';
import '../styles/index.css';
import '../index.css';
---

<Layout>
  <div class="site-noise" aria-hidden="true"></div>
  <div class="ticker" aria-label="Current focus">
    <div class="ticker-track">
      <div class="ticker-group">
        <span>Available for work</span>
        <span>Frontend Engineer</span>
        <span>Based in Nigeria</span>
        <span>Open to remote teams</span>
        <span>Product Engineer</span>
      </div>
      <div class="ticker-group" aria-hidden="true">
        <span>Available for work</span>
        <span>Frontend Engineer</span>
        <span>Based in Nigeria</span>
        <span>Open to remote teams</span>
        <span>Product Engineer</span>
      </div>
      <div class="ticker-group" aria-hidden="true">
        <span>Available for work</span>
        <span>Frontend Engineer</span>
        <span>Based in Nigeria</span>
        <span>Open to remote teams</span>
        <span>Product Engineer</span>
      </div>
    </div>
  </div>

  <header class="header">
    <span class="header-name">
      Kolade<span class="cursor">_</span>
    </span>

    <nav class="header-nav">
      <ThemeToggle client:load />
    </nav>
  </header>

  <main class="main">
    <section class="hero" aria-labelledby="intro-title">
      <p class="hero-kicker">Frontend engineer · shipping globally · Nigeria</p>
      <h1 id="intro-title" class="hero-title">
        Kolade Oyewumi builds interfaces for platforms, products, and teams shipping real software.
      </h1>
      <div class="hero-grid">
        <p class="hero-desc">
          Frontend engineer building production interfaces across Web3,
          developer platforms, health-tech, business operations software, and
          commercial websites.
        </p>
        <div class="hero-proof" aria-label="Selected highlights">
          <span>7+ years experience</span>
          <span>10+ products shipped</span>
          <!-- <span>3+ Web3 product surfaces</span>
          <span>14-language web platform</span> -->
        </div>
      </div>
    </section>

    <section id="experience" class="section">
      <p class="section-label reveal">Experience</p>
      <div class="experience-list">
        {work.map((w, index) => (
          <a
            href={w.url}
            target={w.url !== '#' ? '_blank' : undefined}
            rel="noopener noreferrer"
            class="experience-row reveal"
            style={`--reveal-delay: ${index * 55}ms`}
            data-analytics-event="click_experience"
            data-analytics-label={w.company}
          >
            <div>
              <p class="experience-company">{w.company}</p>
              <p class="experience-role">{w.role}</p>
            </div>
            <div class="experience-meta">
              <span>{w.eyebrow}</span>
              <span>{w.period}</span>
            </div>
            {w.url !== '#' && <span class="experience-arrow">→</span>}
          </a>
        ))}
      </div>
    </section>

    <section id="projects" class="section projects-section">
      <p class="section-label reveal">Featured projects</p>

      <div class="project-grid">
        {featuredProjects.map((project, index) => (
          <article class="project-card reveal" style={`--reveal-delay: ${index * 70}ms`}>
            <div class="project-card-top">
              <span class="card-index">0{index + 1}</span>
              <span class="project-status">{project.status}</span>
            </div>
            <div class="project-card-main">
              <p class="project-category">{project.category}</p>
              <h2>{project.name}</h2>
              <p class="project-summary">{project.summary}</p>
            </div>
            <div class="project-detail-grid">
              <div>
                <span>Role</span>
                <p>{project.role}</p>
              </div>
            </div>
            <div class="project-stack">
              {project.stack.map((item) => <span>{item}</span>)}
            </div>
            <div class="project-links">
              {project.links.map((link) => (
                <a
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-analytics-event="click_project"
                  data-analytics-label={`${project.name}: ${link.label}`}
                >
                  {link.label} ↗
                </a>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Capabilities section hidden for now; keep data/styles available for later review. -->

    <section class="section">
      <p class="section-label reveal">About</p>
      <div class="about-grid reveal">
        <div class="about-copy">
          <p class="about-lede">
            I build frontend systems for production products: dApps, dashboards,
            documentation sites, admin tools, and business websites.
          </p>
          <p class="about-text">
            My work is mostly React and TypeScript. I focus on clean UI,
            predictable state, responsive layouts, API integration, and features
            that stay maintainable after launch.
          </p>
        </div>
        <div class="skills">
          {skillGroups.flatMap((group) => group.items).map((item) => (
            <span class="skill-tag">{item}</span>
          ))}
        </div>
      </div>
    </section>

    <ScrambleDecode client:visible />

    <section class="section connect-section">
      <p class="section-label">Contact</p>
      <div class="contact-panel">
        <div class="contact-copy">
          <p>It’s time to build your next product interface.</p>
          <p class="contact-support">Let’s work together and ship something useful.</p>
          <div class="contact-links" aria-label="Contact links">
            <a
              href="mailto:oyewumi.koladej@gmail.com"
              data-analytics-event="click_email"
              data-analytics-label="contact"
            >
              Email
            </a>
            <a href="https://www.linkedin.com/in/kolade-oyewumi-644492195/" target="_blank" rel="noopener noreferrer" data-analytics-event="click_linkedin" data-analytics-label="contact">LinkedIn</a>
            <a href="https://github.com/corlard3y" target="_blank" rel="noopener noreferrer" data-analytics-event="click_github" data-analytics-label="contact">GitHub</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <a
    class="spotify-widget"
    data-spotify-card
    href="https://open.spotify.com/"
    target="_blank"
    rel="noopener noreferrer"
    aria-live="polite"
    data-analytics-event="click_spotify"
    data-analytics-label="now_playing_widget"
    hidden
  >
    <span class="spotify-logo" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
    </span>
    <span class="spotify-widget-copy">
      <span class="spotify-widget-status" data-spotify-status>I’m currently listening to</span>
      <span class="spotify-widget-meta">
        <span data-spotify-track></span>
        <span class="spotify-separator">—</span>
        <span data-spotify-artist></span>
      </span>
    </span>
    <span class="spotify-widget-action">listen here</span>
  </a>

  <footer class="footer">
    <span class="footer-copy">Made by Kolade ⚡</span>
  </footer>

  <script is:inline>
    function trackAnalyticsEvent(name, params = {}) {
      if (typeof window.gtag !== 'function') return;

      window.gtag('event', name, params);
    }

    trackAnalyticsEvent('page_load', {
      event_category: 'engagement',
      page_path: window.location.pathname,
      page_title: document.title,
    });

    document.addEventListener('click', (event) => {
      const target = event.target instanceof Element ? event.target : null;
      const analyticsTarget = target?.closest('[data-analytics-event]');

      if (!analyticsTarget) return;

      trackAnalyticsEvent(analyticsTarget.dataset.analyticsEvent, {
        event_category: 'engagement',
        event_label:
          analyticsTarget.dataset.analyticsLabel ||
          analyticsTarget.textContent?.trim().slice(0, 100),
        link_url: analyticsTarget.href || undefined,
      });
    });

    document.documentElement.classList.add('reveal-ready');
    const revealTargets = document.querySelectorAll('.reveal, .contact-panel');

    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              revealObserver.unobserve(entry.target);
            }
          });
        },
        { rootMargin: '0px 0px -12% 0px', threshold: 0.12 }
      );

      revealTargets.forEach((target) => revealObserver.observe(target));
    } else {
      revealTargets.forEach((target) => target.classList.add('is-visible'));
    }

    const spotifyCard = document.querySelector('[data-spotify-card]');
    const spotifyStatus = document.querySelector('[data-spotify-status]');
    const spotifyTrack = document.querySelector('[data-spotify-track]');
    const spotifyArtist = document.querySelector('[data-spotify-artist]');

    async function loadSpotifyTrack() {
      if (!spotifyCard || !spotifyStatus || !spotifyTrack || !spotifyArtist) return;

      try {
        const response = await fetch('/.netlify/functions/spotify-now-playing');

        if (!response.ok) throw new Error('Spotify request failed');

        const data = await response.json();

        if (!data.isPlaying) {
          spotifyCard.hidden = true;
          spotifyCard.removeAttribute('href');
          return;
        }

        spotifyCard.hidden = false;
        spotifyStatus.textContent = 'I’m currently listening to';
        spotifyTrack.textContent = data.title;
        spotifyArtist.textContent = data.artist;
        spotifyCard.setAttribute('href', data.url);
      } catch {
        spotifyCard.hidden = true;
        spotifyCard.removeAttribute('href');
      }
    }

    loadSpotifyTrack();
    window.setInterval(loadSpotifyTrack, 10000);

    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) loadSpotifyTrack();
    });
  </script>
</Layout>
